        {
            "key": "field_6971e54f52338",
            "label": "company_about_text",
            "name": "company_about_text",
            "aria-label": "",
            "type": "wysiwyg",
            "instructions": "",
            "required": 0,
            "conditional_logic": 0,
            "wrapper": {
                "width": "",
                "class": "",
                "id": ""
            },
            "default_value": "Компания \"ДИЗАЙН КОМПЛЕКТ\". Ваши идеи — наши материалы! Начав свою деятельность в 2010 году в городе Калининграде в качестве дистрибьютора напольных покрытий для общественных зданий и учреждений, компания \"Дизайн Комплект\" за этот небольшой период работы продемонстрировала колоссальный рост и стала одним из лидеров на Калининградском рынке отделочных материалов для коммерческих интерьеров. Комплексный подход к комплектации, это прежде всего - партнерство. Мы не просто поставляем материалы, мы предлагаем решения – комплексные, индивидуальные, выгодные, превосходящие ожидания наших клиентов.\r\n\r\n\r\nКомпания «ДИЗАЙН КОМПЛЕКТ» сотрудничает в первую очередь с фабриками, которые специализируются на коммерческой продукции, то есть производят покрытия с повышенными требованиями к износостойкости, экологической, санитарной и пожарной безопасности.",
            "allow_in_bindings": 0,
